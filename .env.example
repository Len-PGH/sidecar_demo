# Public base URL where SignalWire reaches this app (use ngrok / cloudflared in dev).
# Basic-auth creds may be embedded in the URL: https://user:pass@host
PUBLIC_URL=https://your-ngrok-id.ngrok-free.app

# Bind config
HOST=0.0.0.0
PORT=3000
ROUTE=/sidecar

# Bridge legs the sidecar listens to
FROM_NUMBER=+15555550100
TO_NUMBER=+15555550199

# Which leg is the customer (the other is the agent)
CUSTOMER_ROLE=remote-caller

# LLM
SIDECAR_MODEL=gpt-4o-mini

# Optional basic auth for the SWML + SWAIG endpoints (webhook side; the
# SignalWire executor authenticates against these when it calls us back).
SWML_BASIC_AUTH_USER=
SWML_BASIC_AUTH_PASSWORD=

# ----------------------------------------------------------------------------
# Sidecar UI auth (browser side)
#
# Gates POST /token (which mints SignalWire subscriber tokens) and,
# indirectly, WS /ws/events (which streams transcripts + LLM insights).
# /token responds 503 until SIDECAR_UI_PASSWORD is set, so the browser
# can't accidentally mint anonymous tokens against a misconfigured deploy.
# Distinct from the webhook basic-auth above — different threat models.
# ----------------------------------------------------------------------------
SIDECAR_UI_USER=admin
SIDECAR_UI_PASSWORD=
# WebSocket upgrade ticket lifetime (seconds). /token issues one ticket per
# call; the browser presents it as ?ticket=... on /ws/events. Default 1h.
SIDECAR_WS_TICKET_TTL=3600

# SignalWire REST credentials (needed for /token + auto-resource provisioning)
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIDECAR_RESOURCE_NAME=sidecar-copilot

# Password for the rep's subscriber identity. REQUIRED for `Go Online`
# (inbound calls) — the relay rejects unpasswordied subscribers with
# -32003 Requester validation failed. Pick something long; first /token
# call sets it, subsequent calls authenticate with it.
SIDECAR_SUBSCRIBER_PASSWORD=
